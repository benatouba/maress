[Unit]
Description=MaRESS FastAPI backend
After=network.target

[Service]
Type=simple
User=ben
Group=ben
WorkingDirectory=/home/ben/projects/maress/backend
Environment="PATH=/home/ben/projects/maress/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/ben/projects/maress/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
