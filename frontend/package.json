{
  "name": "maress-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint --fix . && eslint --fix src/**/*.vue",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@mdi/font": "^7.4.47",
    "@unhead/vue": "^2.1.12",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.14.0",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.33.1",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-fcose": "^2.2.0",
    "lodash": "^4.17.23",
    "ol": "^10.8.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.31",
    "vue-chartjs": "^5.3.3",
    "vuetify": "^4.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-config-vuetify": "4.4.0",
    "eslint-plugin-oxlint": "^1.58.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "jsdom": "^29.0.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.58.0",
    "sass": "^1.98.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.2",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.2.6"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "^0.34.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "unplugin-fonts"
      ],
      "allowedVersions": {
        "eslint-plugin-vuetify>vuetify": "4"
      }
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "sass-embedded",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
