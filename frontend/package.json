{
  "name": "maress-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint --fix . && eslint --fix src/**/*.vue",
    "type-check": "vue-tsc --build --force",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@mdi/font": "^7.4.47",
    "@unhead/vue": "^2.1.6",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.5",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.33.1",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-fcose": "^2.2.0",
    "lodash": "^4.17.23",
    "ol": "^10.8.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-chartjs": "^5.3.3",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.1.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.3.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vuetify": "4.3.5-beta.1",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuetify": "^2.5.3",
    "oxlint": "^1.50.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "beta",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.0.18",
    "vue-router": "^5.0.3",
    "vue-tsc": "^3.2.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "unplugin-fonts"
      ],
      "allowedVersions": {
        "eslint-plugin-vuetify>vuetify": "4"
      }
    }
  }
}
